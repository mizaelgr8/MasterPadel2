
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ATENCIÓN:
    // Estas reglas permiten que cualquier persona lea y escriba en tu base de datos.
    // Esto es necesario para que la aplicación de demostración funcione con su sistema de
    // autenticación personalizado (Admin/Invitado).
    // Para una aplicación en producción, deberías implementar Firebase Authentication
    // y restringir las escrituras solo a usuarios autenticados y autorizados.
    // Ejemplo: allow write: if request.auth != null;
    
    // Se fuerza la actualización de esta regla para el nuevo proyecto.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
